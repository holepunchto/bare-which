{
  "name": "bare-which",
  "version": "2.0.0",
  "description": "Find a program in $PATH",
  "exports": {
    "./package": "./package.json",
    ".": "./index.js"
  },
  "imports": {
    "fs": {
      "bare": "bare-fs",
      "default": "fs"
    },
    "path": {
      "bare": "bare-path",
      "default": "path"
    },
    "process": {
      "bare": "bare-process",
      "default": "process"
    }
  },
  "files": [
    "index.js",
    "lib"
  ],
  "scripts": {
    "format": "prettier --write . && lunte --fix",
    "lint": "prettier --check . && lunte",
    "test": "npm run test:bare && npm run test:node",
    "test:bare": "brittle-bare --coverage test.js",
    "test:node": "brittle-node --coverage test.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/holepunchto/bare-which.git"
  },
  "author": "Holepunch",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/holepunchto/bare-which/issues"
  },
  "homepage": "https://github.com/holepunchto/bare-which#readme",
  "dependencies": {
    "bare-fs": "^3.0.0",
    "bare-path": "^3.0.0",
    "bare-process": "^3.0.0",
    "which-runtime": "^1.2.0"
  },
  "devDependencies": {
    "brittle": "^3.5.0",
    "lunte": "^1.8.6",
    "prettier": "^3.6.2",
    "prettier-config-holepunch": "^2.0.0"
  }
}
